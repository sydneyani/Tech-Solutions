# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored. Never commit real passwords or connection URLs.

# Local MySQL. Create the database before starting the API or running setup-db.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=RailroadDB

# Optional. When DATABASE_URL or MYSQL_URL is set, it replaces the DB_* variables.
# Percent-encode reserved characters in the password.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional comma-separated browser origins, in addition to localhost:3000
# and the origins already listed in backend/server.js.
# CORS_ORIGINS=https://your-frontend.example.com
